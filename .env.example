# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
# Leave as-is for local dev (uses a local SQLite file, totally free).
# When ready for Postgres, e.g.: postgresql://user:password@localhost:5432/hostel_yaar
DATABASE_URL=sqlite:///./hostel_yaar_dev.db

# --- JWT ---
# Generate a strong random value, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- Google OAuth ---
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs > Web client
GOOGLE_CLIENT_ID=

# --- Email (for OTP) ---
# Leave blank during dev -- OTP codes will just print to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
